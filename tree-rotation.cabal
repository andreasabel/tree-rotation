cabal-version: 3.0
name: tree-rotation
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
license-file: LICENSE
synopsis: Tree-rotation puzzle solvers and playground

executable tree-rotation
  main-is: Main.hs
  hs-source-dirs: app
  other-modules:
      DFS
    , Full.Game
    , Full.Search
    , Game
    , MCTS
    , Plot
    , Random
    , Search
    , Tree
  default-language: GHC2021
  ghc-options: -Wall
  build-depends:
      base >= 4.21 && < 5
    , directory >= 1.3
    , hashable >= 1.4
    , optparse-applicative >= 0.18
    , random >= 1.2
    , unordered-containers >= 0.2
